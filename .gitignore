# =========================================================
# .gitignore geral — Portfólio de projetos
# Tecnologias: Python, Node.js, React, Java, C/C++, C#, web
# =========================================================

# -------------------------
# Sistema operacional
# -------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.lnk

# -------------------------
# Editores e IDEs
# -------------------------
.idea/
*.iml
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# -------------------------
# Variáveis de ambiente e segredos
# -------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
secrets/
credentials/

# -------------------------
# Logs e arquivos temporários
# -------------------------
*.log
logs/
log/
*.tmp
*.temp
*.swp
*.swo
*.bak
*.old
*.orig
~*

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
pytestdebug.log
pip-wheel-metadata/
*.egg
*.egg-info/
.eggs/
wheels/
share/python-wheels/
venv/
.venv/
env/
ENV/
.conda/
conda-bld/
.pybuilder/
poetry.toml

# -------------------------
# Node.js, npm, Yarn e pnpm
# -------------------------
node_modules/
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log

# -------------------------
# Front-end / frameworks
# -------------------------
dist/
build/
coverage/
.vite/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
.angular/
.turbo/
.cache/
storybook-static/
*.tsbuildinfo

# -------------------------
# Java / Maven / Gradle
# -------------------------
.gradle/
.mvn/wrapper/maven-wrapper.jar
target/
out/
*.class
hs_err_pid*
replay_pid*

# -------------------------
# C / C++ / CMake / Make
# -------------------------
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json
Testing/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out
*.app
*.pdb
*.ilk
*.pch
*.gch
*.gcda
*.gcno

# -------------------------
# C# / .NET
# -------------------------
[Bb]in/
[Oo]bj/
.vs/
TestResults/
*.user
*.suo
*.cache
project.lock.json
project.fragment.lock.json
artifacts/

# -------------------------
# Bancos de dados locais e arquivos gerados
# -------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal

# -------------------------
# Docker e ferramentas locais
# -------------------------
.docker/
docker-data/
*.pid

# -------------------------
# Relatórios e arquivos de cobertura
# -------------------------
reports/
test-results/
junit.xml
coverage.xml

# -------------------------
# Arquivos compactados e pacotes gerados
# (Remova esta regra se quiser versionar arquivos ZIP de exercícios.)
# -------------------------
*.zip
*.7z
*.rar

# -------------------------
# Pastas de saída comuns
# -------------------------
tmp/
temp/
.cache-loader/
